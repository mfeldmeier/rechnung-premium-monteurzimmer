# Kopie als .env anlegen. .env ist in .gitignore und gehoert NICHT ins Repo.

APP_ENV=prod
APP_URL=https://rechnung.premium-monteurzimmer.com

# WordPress-MySQL im selben netcup-Paket. Die IP ist paketintern erreichbar,
# von aussen nicht - lokal nur ueber einen SSH-Tunnel.
DB_HOST=10.35.232.161
DB_PORT=3306
DB_NAME=k312683_wordpress_2
DB_USER=k312683_wordpress_f
DB_PASS=
DB_PREFIX=pmz_

# Ablage der erzeugten PDFs, ausserhalb des Docroots halten.
STORAGE_PATH=../storage

# Postfach mit den secra-Buchungsbestaetigungen (bin/import-bookings.php).
# Auf dem Server liegt das Postfach auf derselben Maschine, deshalb 127.0.0.1:
# so verlaesst weder Passwort noch Anhang jemals den Rechner. Das Zertifikat
# traegt den oeffentlichen Hostnamen und passt nie zur IP - darum die Pruefung
# hier aus. Zeigt IMAP_HOST nach aussen, gehoert sie wieder auf 1.
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=0
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
# Nur diese Mails werden angefasst. Alles andere im Posteingang bleibt liegen,
# auch wenn ein PDF daran haengt.
IMAP_SENDER=channel-manager@secra.de
IMAP_SUBJECT_PREFIX=Buchungsbestätigung Nr
# Verarbeitete und gescheiterte Mails wandern hierhin, damit der Posteingang
# nicht zulaeuft und ein Fehlschlag auffaellt. Ordner vorher im Postfach anlegen.
IMAP_DONE_FOLDER=INBOX.Erledigt
IMAP_FAIL_FOLDER=INBOX.Fehler
