{
    "name": "reher/premium-monteurzimmer-rechnungen",
    "description": "Rechnungserstellung fuer Premium Monteurzimmer Reher",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "horstoeko/zugferd": "^1.0",
        "mpdf/mpdf": "^8.2",
        "smalot/pdfparser": "^2.13",
        "webklex/php-imap": "^6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Pmz\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pmz\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.33"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php db/migrate.php"
    }
}
